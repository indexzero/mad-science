<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>family.curtain</string>
  <key>ProgramArguments</key>
  <array><string>@BINARY@</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/family.curtain/curtain.out.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/family.curtain/curtain.err.log</string>
</dict>
</plist>
